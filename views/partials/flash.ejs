<%if(typeof success!=="undefined"&&success&&success.length){%>
    <div class="alert alert-success" role="alert">
        <%=success%>
    </div>
    <%}%>

        <%if(typeof error!=="undefined"&&error&&error.length){%>
            <div class="alert alert-danger" role="alert">
                <%=error%>
            </div>
            <%}%>