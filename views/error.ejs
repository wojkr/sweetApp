<% layout('./layouts/boilerplate') -%>
  <div class="alert alert-danger col-md-6 offset-md-3" role="alert">
    <h4 class="alert-heading text-center">
      <%=typeof statusCode!=="undefined"&&statusCode?statusCode:500%> ERROR: <%=typeof errName!=="undefined"&&errName?errName:"Error"%>
    </h4>
    <p>
      <%=typeof message!=="undefined"&&message?message:"Something went wrong."%>
    </p>
    <a href="<%=typeof path!=="undefined"&&path?path:'/'%>" class="btn btn-danger btn-lg active" role="button" aria-pressed="true">Go back</a>
    <hr />
    <%if (typeof stack!=="undefined"&&stack) {%>
      <p class="mb-0">
        <%=stack%>
      </p>
      <%}%>
  </div>
